# All keys are server-side only. Nothing here is exposed to the browser.
# Copy to .env.local (gitignored) and fill in there. Never commit a real key.

# EIA API v2 — free, instant key at https://www.eia.gov/opendata/register.php
# Without it the app runs on the DOER snapshot and shows a "snapshot" badge.
EIA_API_KEY=

# Babson seminar LiteLLM gateway — bill OCR. Takes precedence over the keys below.
# Its `/v1/messages` endpoint speaks the Anthropic shape and authenticates with x-api-key.
BABSON_GATEWAY_KEY=
# BABSON_GATEWAY_URL=https://ca-litellm-mint-eus2.orangeflower-5d81efa8.eastus2.azurecontainerapps.io
# BABSON_GATEWAY_MODEL=claude-sonnet-5

# Anthropic — bill OCR + one explanation call. Optional: manual entry works without it.
ANTHROPIC_API_KEY=

# Census API — optional, only used by the build-time map bake.
CENSUS_API_KEY=

# Public origin used for metadata and share cards. Optional: the production URL
# is the default, so local and deployed builds both work without this.
NEXT_PUBLIC_SITE_URL=

# OpenRouter — any vision model by slug. Used when no Anthropic console key is present.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-3-12b-it

# ---------------------------------------------------------------------------
# Switch flow (Addendum B §3.6). Optional: with nothing set, the switch screen
# shows published options and the switch kit, and states that outreach is off.
# ---------------------------------------------------------------------------

# Master switch for contacting providers. Anything other than "true" sends nothing.
PROVIDER_OUTREACH_ENABLED=false

# The only provider source this build has. JSON array; every row carries source
# and asOf (R22.3), and `allowlist: true` marks a team test line (R19.8).
# Allowlist rows are staged, never presented as a real business.
# Example shape:
# PROVIDER_ALLOWLIST_JSON=[{"id":"team-line","name":"Team test line","kind":"fuel","channels":["email"],"phone":null,"email":"quotes@example.com","source":"Team allowlist","asOf":"2026-10-24","allowlist":true}]
PROVIDER_ALLOWLIST_JSON=

# Email outreach (Resend). Without both values no email leaves the server.
RESEND_API_KEY=
RESEND_FROM=

# Phone outreach (ElevenLabs ConvAI). All three values are server-side only.
# With any one missing, the switch screen says calling is off and the switch kit
# becomes the step-by-step path. Check the whole chain with:
#   npm run voice:check
# and place one real call with:
#   npm run voice:call -- --dial +1XXXXXXXXXX
# Create the reviewed agent from `agents/quote-caller/` once:
#   npm run agents:create
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The id from GET /v1/convai/phone-numbers after a Twilio number is imported.
ELEVENLABS_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Outreach security.
#
# Minting a consent token is the household's own press of the confirm button, so
# it is accepted from this origin (`sec-fetch-site: same-origin`, or an Origin
# header matching the host) and refused from any other page. A client that sends
# no origin evidence at all — curl, a server — must still carry
# `x-operator-key: <OPERATOR_KEY>`.
# ---------------------------------------------------------------------------

# Signs consent tokens and call references. 32+ characters, required for live
# outreach in production (without it the routes answer 503). Generate with:
# openssl rand -hex 32
CONSENT_SECRET=

# Shared secret for non-browser callers. Unset means they are refused with 503.
OPERATOR_KEY=

# Global ceiling on outbound calls and emails per 24 hours (default 60). Per-IP
# limits are separate and built in.
# OUTBOUND_DAILY_CAP=60

# Also set spend limits on the vendor side (ElevenLabs usage cap, Twilio and
# Resend monthly limits). The in-process caps reset on restart and are per
# instance; the vendor limit is the one that actually stops a bill.
