# All keys are server-side only. Nothing here is exposed to the browser.

# EIA API v2 — free, instant key at https://www.eia.gov/opendata/register.php
# Without it the app runs on the DOER snapshot and shows a "snapshot" badge.
EIA_API_KEY=

# Anthropic — bill OCR + one explanation call. Optional: manual entry works without it.
ANTHROPIC_API_KEY=

# Census API — optional, only used by the build-time map bake.
CENSUS_API_KEY=
