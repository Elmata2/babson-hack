{
  "name": "buildlog-sync",
  "version": "1",
  "description": "Every time source is edited, log newly shipped features (@built F-NN) and regenerate BUILDLOG.md.",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "lib/**/*.ts",
      "app/**/*.ts",
      "app/**/*.tsx",
      "components/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "node scripts/buildlog.mjs hook"
  }
}
