{
  "name": "switchpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The honest heat pump verdict for Massachusetts. Hackachusetts 2026, Babson hub, Climate Tech C2.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint . && vitest run",
    "guard": "node scripts/ci-guard.mjs",
    "log": "node scripts/buildlog.mjs hook",
    "status": "node scripts/buildlog.mjs status",
    "agents:check": "node scripts/agents/sync.mjs --check",
    "agents:sync": "node scripts/agents/sync.mjs",
    "agents:create": "node --env-file-if-exists=.env.local scripts/agents/sync.mjs --create",
    "voice:check": "node --env-file-if-exists=.env.local scripts/voice/check.mjs",
    "voice:call": "node --env-file-if-exists=.env.local scripts/voice/check.mjs",
    "agents:simulate": "node scripts/agents/simulate.mjs",
    "bills": "node scripts/demo-bills/render.mjs",
    "bills:eval": "node scripts/demo-bills/eval.mjs",
    "watch:log": "node scripts/buildlog.mjs watch",
    "bake": "node scripts/bake-utilities.mjs && node scripts/bake-hdd.mjs && node scripts/bake-map.mjs && node scripts/trim-geo.mjs && node scripts/bake-heat-svg.mjs",
    "bake:check": "node scripts/bake-utilities.mjs --check && node scripts/bake-hdd.mjs --check && node scripts/bake-map.mjs --check && node scripts/trim-geo.mjs --check && node scripts/bake-heat-svg.mjs --check",
    "submission": "node scripts/submission/check.mjs --review",
    "demo:plan": "node scripts/demo/record.mjs --check",
    "demo:video": "node scripts/demo/record.mjs",
    "hooks:test": "node scripts/hooks/protect-kiro.test.mjs",
    "mcp": "tsx mcp/switchpoint-server.ts",
    "pbt:mutants": "node scripts/pbt-mutation-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "geist": "^1.8.2",
    "maplibre-gl": "^4.7.1",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  }
}
